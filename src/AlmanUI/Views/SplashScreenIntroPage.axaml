<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="500"
		Width="500" Height="500"
        x:Class="AlmanUI.Views.SplashScreenIntroPage"
        Title="SplashScreenIntroPage">
	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
		<TextBlock Text="Username:" />
		<TextBox x:Name="UsernameTextBox" Width="200" />
		<TextBlock Text="Password:" />
		<TextBox x:Name="PasswordBox" Width="200" PasswordChar="*" />
		<Button x:Name="LoginButton" Content="Login" Width="100" HorizontalAlignment="Center" />
	</StackPanel>
</Window>
