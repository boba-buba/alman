<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ViewModels="clr-namespace:AlmanUI.ViewModels"
			 xmlns:Models="using:AlmanUI.Models"
			 xmlns:SharedModels="using:Alman.SharedModels"
			 xmlns:local="clr-namespace:AlmanUI.Resources"
			 xmlns:SharedDefs="using:Alman.SharedDefinitions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AlmanUI.Views.YearSubsPageView"
			 x:DataType="ViewModels:YearSubsPageViewModel">
	<UserControl.Styles>
		<StyleInclude Source="../Assets/GridDbTableStyle.axaml"/>
	</UserControl.Styles>
	<Grid RowDefinitions="Auto, *, Auto">
		<Border Grid.Row="0" Height="100">
			<Grid ColumnDefinitions="2*, *, 2*">
				<Button Grid.Column="0" Margin="5" HorizontalAlignment="Right" Command="{Binding TriggerPrevYearCommand}" Content="{x:Static local:CommonResources.Previous}"></Button>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="30" Margin="30" Text="{Binding CurrentYear}"></TextBlock>
				<Button Grid.Column="3" Margin="5" HorizontalAlignment="Left" Command="{Binding TriggerNextYearCommand}" Content="{x:Static local:CommonResources.Next}"></Button>
			</Grid>
		</Border>

		<DataGrid Classes="db-table" Grid.Row="1" Name="YearSubsMainDataGrid" ItemsSource="{Binding ChildYearSubs}"/>
		
		
		<StackPanel Grid.Row="2" Margin="10">
			<Grid ColumnDefinitions="Auto" HorizontalAlignment="Center">
				<Button Name="SaveYearSubsButton" Grid.Column="0" Margin="5" HorizontalAlignment="Center" Command="{Binding TriggerSaveCommand}" Content="{x:Static local:CommonResources.Save}"></Button>
			</Grid>
		</StackPanel>
	</Grid>

</UserControl>
