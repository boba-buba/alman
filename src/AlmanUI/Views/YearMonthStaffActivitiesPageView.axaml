<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:ViewModels="clr-namespace:AlmanUI.ViewModels"
			 xmlns:Models="using:AlmanUI.Models"
			 xmlns:local="clr-namespace:AlmanUI.Resources"
			 xmlns:SharedModels="using:Alman.SharedModels"
			 xmlns:SharedDefs="using:Alman.SharedDefinitions"
             x:Class="AlmanUI.Views.YearMonthStaffActivitiesPageView"
			 x:DataType="ViewModels:YearMonthStaffActivitiesPageViewModel">
	<UserControl.Styles>
		<StyleInclude Source="../Assets/GridDbTableStyle.axaml"/>
	</UserControl.Styles>
	<Grid RowDefinitions="Auto, *, Auto">
		<Border Grid.Row="0" Height="100">
			<Grid ColumnDefinitions="2*, *, *, 2*">
				<Button Grid.Column="0" Margin="5" HorizontalAlignment="Right" Command="{Binding TriggerPrevMonthCommand}" Content="{x:Static local:CommonResources.Previous}"></Button>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="30" Margin="30" Text="{Binding CurrentMonth}"></TextBlock>
				<TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="30" Margin="30" Text="{Binding CurrentYear}"></TextBlock>
				<Button Grid.Column="3" Margin="5" HorizontalAlignment="Left" Command="{Binding TriggerNextMonthCommand}" Content="{x:Static local:CommonResources.Next}"></Button>
			</Grid>
		</Border>

		<DataGrid Name="YearMonthStaffActivitiesMainDataGrid" ItemsSource="{Binding MemberActivities}" Grid.Row="1" Classes="db-table">
		</DataGrid>

		<StackPanel Grid.Row="2" Margin="10">
			<Grid ColumnDefinitions="Auto" HorizontalAlignment="Center">
				<Button Name="SaveMonthStaffActivitiesButton" Grid.Column="0" Margin="5" HorizontalAlignment="Center" Command="{Binding TriggerSaveCommand}" Content="{x:Static local:CommonResources.Save}"></Button>
			</Grid>

		</StackPanel>
	</Grid>
</UserControl>
