<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ViewModels="clr-namespace:AlmanUI.ViewModels"
			 xmlns:Models="using:AlmanUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AlmanUI.Views.HomePageView"
			 x:DataType="ViewModels:HomePageViewModel">
	<Grid RowDefinitions="Auto, *, Auto">
		<Border Grid.Row="0" Height="100">
			<Grid ColumnDefinitions="2*, *, 2*">
				<Button Grid.Column="0" Margin="5" HorizontalAlignment="Right" Command="{Binding TriggerPrevYearCommand}">PREVIOUS</Button>
				<TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="30" Margin="30" Text="{Binding CurrentYear}"></TextBlock>
				<Button Grid.Column="3" Margin="5" HorizontalAlignment="Left" Command="{Binding TriggerNextYearCommand}">NEXT</Button>
			</Grid>
		</Border>

		<Grid Grid.Row="1" RowDefinitions="*, *, *">
			<Grid  Grid.Row="0" ColumnDefinitions="*, *" HorizontalAlignment="Center">
				<TextBlock Grid.Column="0" Text="Left From Prev. Year:" Margin="10" HorizontalAlignment="Center" FontSize="30"></TextBlock>
				<TextBlock Grid.Column="1" Text="{Binding LastYearRemainder}" Margin="10" HorizontalAlignment="Center" FontSize="30"/>
			</Grid>
			<Grid  Grid.Row="1" ColumnDefinitions="*, *" HorizontalAlignment="Center">
				<TextBlock Grid.Column="0" Text="Year Subs Sum:" Margin="10" HorizontalAlignment="Center" FontSize="30"></TextBlock>
				<TextBlock Grid.Column="1" Text="{Binding YearSubsSum}" Margin="10" HorizontalAlignment="Center" FontSize="30"/>
			</Grid>
			<Grid  Grid.Row="2" ColumnDefinitions="*, *" HorizontalAlignment="Center">
				<TextBlock Grid.Column="0" Text="Remainder:" Margin="10" HorizontalAlignment="Center" FontSize="30"></TextBlock>
				<TextBlock Grid.Column="1" Text="{Binding YearRemainder}" Margin="10" HorizontalAlignment="Center" FontSize="30"/>
			</Grid>
		</Grid>
		
		<StackPanel Grid.Row="2" Margin="10">
			<Grid ColumnDefinitions="Auto" HorizontalAlignment="Center">
				<Button Name="SaveYearSubsButton" Grid.Column="0" Margin="5" HorizontalAlignment="Center" Command="{Binding TriggerCalculateRemainder}">CALCULTAE REMAINDER</Button>
			</Grid>
		</StackPanel>
	</Grid>

</UserControl>
