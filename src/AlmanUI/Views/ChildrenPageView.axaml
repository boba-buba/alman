<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ViewModels="clr-namespace:AlmanUI.ViewModels"
			 xmlns:Models="using:AlmanUI.Models"
			 xmlns:local="clr-namespace:AlmanUI.Resources"
			 xmlns:SharedModels="using:Alman.SharedModels"
			 xmlns:SharedDefs="using:Alman.SharedDefinitions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AlmanUI.Views.ChildrenPageView"
			 x:DataType="ViewModels:ChildrenPageViewModel">
	<UserControl.Styles>
		<StyleInclude Source="../Assets/GridDbTableStyle.axaml"/>
	</UserControl.Styles>
	<Grid RowDefinitions="Auto, *, Auto">
		<Border Grid.Row="0" Height="100">
			<TextBlock Text="{x:Static local:ChildrenResources.ChildrenPageName}" HorizontalAlignment="Center" FontSize="40" Margin="20"/>
		</Border>
		<DataGrid Name="ChildrenDataGrid" Classes="db-table" Grid.Row="1" ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedChild}"/>
		
		<StackPanel Grid.Row="2" Margin="10">
			<Grid ColumnDefinitions="Auto, Auto, Auto" HorizontalAlignment="Center">
				<Button Grid.Column="0" Margin="5" HorizontalAlignment="Center" Command="{Binding TriggerSaveCommand}" Content="{x:Static local:CommonResources.Save}"></Button>
				<Button Grid.Column="1" Margin="5" HorizontalAlignment="Center" Command="{Binding TriggerAddNewChildCommand}" Content="{x:Static local:CommonResources.Add}"></Button>
				<Button Grid.Column="2" Margin="5" HorizontalAlignment="Center" Command="{Binding TriggerRemoveChildCommand}" Content="{x:Static local:CommonResources.Remove}"></Button>
			</Grid>	
		</StackPanel>
	</Grid>
	
</UserControl>
